// Version resource + manifest. Giving the binary real metadata is one of the
// cheapest ways to stop AV/EDR heuristics treating an unsigned tool as suspect.
#include <windows.h>

1 RT_MANIFEST "horus.manifest"

#define HORUS_VER 3,0,0,0
#define HORUS_VER_STR "3.0.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    HORUS_VER
 PRODUCTVERSION HORUS_VER
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "HORUS"
            VALUE "FileDescription",  "IOC enrichment and PE static analysis"
            VALUE "FileVersion",      HORUS_VER_STR
            VALUE "InternalName",     "horus"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "horus.exe"
            VALUE "ProductName",      "HORUS - the all-seeing eye"
            VALUE "ProductVersion",   HORUS_VER_STR
            VALUE "Comments",         "Open-source Windows security triage tool. https://github.com/mobinert/HORUS"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
