#include <windows.h>

1 RT_MANIFEST "@HORUS_MANIFEST_PATH@"

#define HORUS_VER @HORUS_VERSION_COMMA@
#define HORUS_VER_STR "@HORUS_VERSION_QUAD@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    HORUS_VER
 PRODUCTVERSION HORUS_VER
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "HORUS"
            VALUE "FileDescription",  "Persistent case analysis and Windows PE triage"
            VALUE "FileVersion",      HORUS_VER_STR
            VALUE "InternalName",     "horus"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Mobin Erteghaie"
            VALUE "OriginalFilename", "@HORUS_ORIGINAL_FILENAME@"
            VALUE "ProductName",      "HORUS - the all-seeing eye"
            VALUE "ProductVersion",   HORUS_VER_STR
            VALUE "Comments",         "Open-source Windows security triage tool. https://github.com/mobinert/HORUS"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
